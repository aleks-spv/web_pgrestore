# PostgreSQL connection
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Password for pg_restore env (leave empty if peer auth / pgpass)
# PGPASSWORD=

# pg_restore / gzip binary dir (leave empty if in PATH)
PGPRO_BIN_DIR=

# Backup root: dumps are expected under BACKUP_ROOT/<dbname>/
BACKUP_ROOT=/mnt/backups/dump

# Default owner when pg_database.datdba is missing
DEFAULT_OWNER=usr1cv8

# Authentication (empty = disabled; only for loopback binds)
AUTH_USER=
AUTH_PASS=

# Flask secret key (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Server bind
APP_HOST=127.0.0.1
APP_PORT=5000

# Trust X-Forwarded-* headers (ONLY behind nginx/reverse-proxy)
TRUST_PROXY=0

# Allow running without auth on non-loopback APP_HOST
ALLOW_UNAUTHENTICATED=0

# Session cookie Secure flag (set 1 behind HTTPS)
# Also drives the _csrf_token cookie's Secure flag.
SESSION_COOKIE_SECURE=0

# Extra origins allowed to POST here (comma-separated scheme://host[:port]).
# Only needed when a reverse proxy makes the browser Origin differ from the
# Host header the app sees — otherwise leave empty.
CSRF_TRUSTED_ORIGINS=

# pg_restore timeout in seconds (0 = unlimited, not recommended)
SUBPROCESS_TIMEOUT=300

# pg_restore --parallel (0 = off)
PGPRO_PARALLEL=0

# Max concurrent restore jobs (global)
MAX_CONCURRENT_RESTORES=2

# Disable in-memory rate limits (tests only)
RATE_LIMIT_ENABLED=1
